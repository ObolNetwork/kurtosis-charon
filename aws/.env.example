# AWS fleet config. Copy to `.env` (same dir, gitignored) and fill in.
# Source this file before running `make start-aws`.

# Required:
PROMETHEUS_REMOTE_WRITE_TOKEN=

# Optional (defaults shown):
# CHARON_VERSION=v1.10.3
# LIFETIME=60m
# ONLY=                          # filter combos: cl:lighthouse, vc:vouch, lighthouse-lodestar
