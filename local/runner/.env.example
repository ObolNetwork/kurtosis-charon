# Runner config. Copy to `.env` (same dir, gitignored) and fill in.
# The runner loads this file at startup; real env vars and --flags override it.
# Point elsewhere with RUNNER_ENV_FILE=/path/to/env.

# Required:
RUNNER_SLACK_WEBHOOK_URL=
RUNNER_REPO_PATH=/opt/kurtosis-charon
RUNNER_STATE_PATH=/var/lib/runner/state.json

# Optional (defaults shown):
RUNNER_MONITORING_TOKEN=
# RUNNER_PARAMS_DIR=<repo>/deployments
# RUNNER_PACKAGE_REF=github.com/ObolNetwork/ethereum-package@6.1.0-obol.3
# RUNNER_LOG_DIR=<home>/runner-logs   # where failing-run logs are archived

# Slack file upload of failing-run log archives (optional). Needs a Slack app
# bot token with the files:write scope and the target channel id. Without both,
# logs are still saved locally and the report includes the archive path.
RUNNER_SLACK_BOT_TOKEN=
RUNNER_SLACK_CHANNEL_ID=

# Per-commit results summary table (posted to the webhook once all combos have
# run under a repo commit; partial + N/A if a new commit supersedes it first).
# RUNNER_SUMMARY_MENTION pings a group/user on that message (empty = no ping).
# RUNNER_RESULTS_PATH=<state-dir>/runner-results.json
# RUNNER_SUMMARY_MENTION=<!subteam^S000000|protocol>
# RUNNER_RUN_MINUTES=90
# RUNNER_WARMUP_MINUTES=15
# RUNNER_STARTUP_DEADLINE_MINUTES=25
# RUNNER_SAMPLE_INTERVAL_S=15
# RUNNER_INTER_RUN_BACKOFF_S=30
# RUNNER_MAX_BACKOFF_S=900
