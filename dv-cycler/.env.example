# dv-cycler config. Copy to `.env` (same dir, gitignored) and fill in.
# The cycler loads this file at startup; real env vars and --flags override it.
# Point elsewhere with CYCLER_ENV_FILE=/path/to/env.

# Required:
CYCLER_SLACK_WEBHOOK_URL=
CYCLER_REPO_PATH=/opt/kurtosis-charon
CYCLER_STATE_PATH=/var/lib/dv-cycler/state.json

# Optional (defaults shown):
CYCLER_MONITORING_TOKEN=
# CYCLER_PARAMS_DIR=<repo>/dv-cycler/network-params
# CYCLER_PACKAGE_REF=github.com/ObolNetwork/ethereum-package@charon
# CYCLER_LOG_DIR=<home>/dv-cycler-logs   # where failing-run logs are archived

# Slack file upload of failing-run log archives (optional). Needs a Slack app
# bot token with the files:write scope and the target channel id. Without both,
# logs are still saved locally and the report includes the archive path.
CYCLER_SLACK_BOT_TOKEN=
CYCLER_SLACK_CHANNEL_ID=
# CYCLER_RUN_MINUTES=90
# CYCLER_WARMUP_MINUTES=15
# CYCLER_STARTUP_DEADLINE_MINUTES=25
# CYCLER_SAMPLE_INTERVAL_S=15
# CYCLER_INTER_RUN_BACKOFF_S=30
# CYCLER_MAX_BACKOFF_S=900
