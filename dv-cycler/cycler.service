[Unit]
Description=DV 36-combo test cycler
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=dv
WorkingDirectory=/opt/kurtosis-charon/dv-cycler
Environment=GOCACHE=/var/cache/dv-cycler/go-build
Environment=HOME=/opt/kurtosis-charon
# CYCLER_* config (webhook, repo/state paths, token, ...) is read from a .env
# file in WorkingDirectory at startup. Copy .env.example -> .env and fill it in.
ExecStart=/opt/homebrew/bin/go run .
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
